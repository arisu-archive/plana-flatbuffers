namespace MX.Data.Excel;

table ShopCashExcel {
    id: long;
    cash_product_id: long;
    package_type: PurchaseSourceType;
    target_group: TargetGroup;
    localize_etc_id: uint;
    in_mail_purchase_lock: bool;
    use_mail_parcel: bool;
    icon_path: string;
    display_order: long;
    renewal_display_order: long;
    shop_cash_stepup_id: long;
