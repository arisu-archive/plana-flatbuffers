include "ParcelType.fbs";
include "StoreType.fbs";

namespace MX.Data.Excel;

table ProductDailyRecordExcel {
    id: long;
    product_id: string;
    store_type: StoreType;
    price: long;
    purchase_count_limit: long;
    reward_id: long;
    parcel_type: [ParcelType];
    parcel_id: [long];
    parcel_amount: [long];
    title_image_path: string;
}

root_type ProductDailyRecordExcel;